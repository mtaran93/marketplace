# Production-style environment. Copy to .env.production (git- and docker-ignored)
# and replace every CHANGE_ME. Used for BOTH compose interpolation (--env-file)
# and the app container's environment (env_file:).

# --- Docker Compose ----------------------------------------------------------
COMPOSE_PROJECT_NAME=marketplace-prod
APP_VERSION=prod

# --- Laravel -----------------------------------------------------------------
APP_NAME=Marketplace
APP_ENV=production
APP_DEBUG=false
# Generate once: docker compose exec app php artisan key:generate --show
APP_KEY=
APP_URL=https://marketplace.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- PostgreSQL --------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=CHANGE_ME
DB_CONNECT_TIMEOUT=2
# Server-side bounds per statement / per lock wait (Postgres units). Override per run
# for long migrations: docker compose exec -e DB_STATEMENT_TIMEOUT=0 app php artisan migrate
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=3s
# Host port on the server's 127.0.0.1 for SSH-tunnel access (DataGrip etc.).
# Pick a non-default port if the server runs its own Postgres.
DB_FORWARD_PORT=5433

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_TIMEOUT=1
REDIS_READ_TIMEOUT=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
