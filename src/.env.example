# --- Docker Compose ----------------------------------------------------------
# Unique per checkout so two stacks on one host don't collide (C1).
COMPOSE_PROJECT_NAME=marketplace
# Host port for nginx (only published port; bound to 127.0.0.1).
WEB_PORT=8083
# Host user ids baked into the app image so bind-mounted files stay yours.
# Run `id -u` / `id -g` and adjust if they are not 1000.
UID=1000
GID=1000

# --- Laravel -----------------------------------------------------------------
APP_NAME=Marketplace
APP_ENV=local
APP_KEY=
# true ONLY for local development. Production sets APP_DEBUG=false (S1).
APP_DEBUG=true
APP_URL=http://localhost:8083

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (service `db`) -------------------------------------------------
# Used by Laravel AND by compose.yaml to initialise the db container.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
# Local-only default. Never reuse outside your laptop.
DB_PASSWORD=marketplace_local_only
DB_CONNECT_TIMEOUT=2
# Server-side bounds per statement / per lock wait (Postgres units). Override per run
# for long migrations: docker compose exec -e DB_STATEMENT_TIMEOUT=0 app php artisan migrate
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=3s
# Host port on 127.0.0.1 for GUI clients (DataGrip). 5432 is often taken by a host Postgres.
DB_FORWARD_PORT=5435

# --- Redis (service `redis`) ---------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Local-only default. Never reuse outside your laptop.
REDIS_PASSWORD=redis_local_only
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_TIMEOUT=1
REDIS_READ_TIMEOUT=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Prepared for Days 21-30; nothing consumes the queue yet.
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
